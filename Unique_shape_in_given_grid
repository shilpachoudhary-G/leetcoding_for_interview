int find_unique_shape_in_grid(vector<vector<int>> grid)
{
  int r = vector.size();
  int c = vector[0].size();
  set<vector<pair<int,int>>> s; 
  vector<vector<bool>> visited; 
  for(int i=0;i< r;i++)
  {
    for(int j=0;j<c;j++)
    {
     vector<pair<int,int>> res;
     if(grid[i][j]==1 && !visited[i][j])
     { 
       res.push_back({i-i,j-j});
       dfs(i,j,r,c,grid,visited,res);
     }
